{
  "name": "cosmic-futures-laboratory",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "validate:vercel": "node scripts/validate-vercel.mjs",
    "validate:api": "node scripts/validate-api.mjs",
    "release:check": "node scripts/release-check.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "check:arch": "node scripts/check-architecture.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/test.mjs",
    "coverage": "node scripts/test.mjs --coverage",
    "typecheck": "tsc --noEmit",
    "examples": "node scripts/run-ts.mjs scripts/generate-examples.ts",
    "golden:update": "node scripts/run-ts.mjs scripts/golden-corpus.ts",
    "bench": "node scripts/run-ts.mjs scripts/bench.ts",
    "fuzz": "node scripts/run-ts.mjs scripts/fuzz.ts",
    "check": "npm test && npm run typecheck && npm run lint && npm run check:arch && npm run bench -- --check-counters --counters-only && npm run format:check && npm run examples"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.13.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "description": "A reproducible numerical laboratory for conditional cosmological futures.",
  "license": "MIT"
}
