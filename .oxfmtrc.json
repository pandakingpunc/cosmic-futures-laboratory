{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    ".test-output/**",
    ".venv/**",
    ".vercel/**",
    ".wrangler/**",
    "bun.lock",
    "bun.lockb",
    "dist/**",
    "docs/scipy-validation.json",
    "examples/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "tests/golden/corpus.json",
    "tests/reference/pow.json",
    "yarn.lock"
  ]
}
